# dependencies
node_modules/

# build output
dist/

# turborepo
.turbo/

# test output
coverage/
playwright-report/
test-results/
**/playwright/.cache/

# environment — local secrets are never committed
.env
.env.*
!.env.example

# local issue tracker (mattpocock/skills) — maps, specs, and tickets are the
# canonical tracker artifacts and are committed; everything else in .scratch/
# (prototypes, research working files) stays local
.scratch/*
!.scratch/*/
.scratch/*/*
!.scratch/*/map.md
!.scratch/*/spec.md
!.scratch/*/issues/

# misc
*.log
.DS_Store
