# dependencies
node_modules/

# build output
dist/

# turborepo
.turbo/

# test output
coverage/
playwright-report/
test-results/
**/playwright/.cache/

# environment — local secrets are never committed
.env
.env.*
!.env.example

# local issue tracker (mattpocock/skills) — maps, specs, and tickets are the
# canonical tracker artifacts and are committed; everything else in .scratch/
# (prototypes, research working files) stays local
.scratch/*
!.scratch/*/
.scratch/*/*
!.scratch/*/map.md
!.scratch/*/spec.md
!.scratch/*/design-brief.md
!.scratch/*/issues/

# design-sync (claude.ai/design) — staged converter scripts, regenerated build
# output, and machine-local state; the durable inputs under .design-sync/
# (config.json, NOTES.md, conventions.md, previews/, overrides/) ARE committed
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules/

# misc
*.log
.DS_Store

# Lavish review artifacts stay local
.lavish/
