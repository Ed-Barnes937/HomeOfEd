# family's environment — copy to .env (gitignored) for local prod-mode runs.
# In production every one of these comes from Fly secrets, never a committed file.

# Port the prod server listens on (default 8080).
# PORT=8080

# Postgres connection string. Required by the server (its deep /health
# round-trips the Store) and by the release-time migration step (`pnpm migrate`).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/family

# --- arrives with ticket 04 (identity) ---
# The Ed25519 private key that signs family session tokens. This is the one
# secret in the estate that can mint a token, so it lives only on this app.
# Generate a throwaway pair for local runs; never reuse the committed test key
# from @hoe/accounts/testing.
# FAMILY_TOKEN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
#
# Registration is invite-gated while the service is a household pilot (ADR 0057).
# REGISTRATION_INVITE_CODE=dev-insecure-invite
#
# Better Auth's own signing secret.
# BETTER_AUTH_SECRET=dev-insecure-secret
